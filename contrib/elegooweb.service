[Unit]
Description=Elegoo CC2 Web Service
Documentation=https://github.com/runnane/elegoo-web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=elegooweb
Group=elegooweb
WorkingDirectory=/opt/elegooweb
EnvironmentFile=/opt/elegooweb/.env
# @BUN@ is substituted by contrib/install.sh with the absolute path it resolved from
# `command -v bun`. systemd does not search $PATH, and bun's installer drops the binary
# in a different place depending on how it was run — so the path is decided at install
# time rather than guessed here.
#
# No `--import tsx` and no build step: bun executes the TypeScript directly.
ExecStart=@BUN@ src/server/index.ts
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=elegooweb

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/elegooweb
# Anything the service creates under /opt/elegooweb — data/state.json, logs, cached
# gcode — is owner+group only. Without this the process umask decides, and the default
# 022 would write a world-readable state file (ELEG-20).
UMask=0027

# Environment
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
