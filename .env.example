# Elegoo CC2 Service Configuration

# Printer connection
PRINTER_IP=192.168.1.150
PRINTER_PASSWORD=123456

# Service port (WebSocket + REST API)
SERVICE_PORT=8088

# Camera (MJPEG stream from printer)
CAMERA_ENABLED=true
# CAMERA_URL=http://192.168.1.150:8080  # defaults to http://<PRINTER_IP>:8080

# Home Assistant (optional — all three are needed, or it stays off)
#
# Ambient temperature and humidity, which the printer cannot measure. Humidity is the
# one that matters for filament: it decides whether a spool prints cleanly, and it is
# the only way to tell whether a drying session achieved anything.
#
# The token is a LONG-LIVED ACCESS TOKEN, made in Home Assistant under your profile →
# Security → Long-lived access tokens. It carries your account's permissions, so make it
# on an account with as little access as you can live with. This service only ever
# issues GET /api/states/<entity> — it never writes — but the token itself does not know
# that.
HOMEASSISTANT_URL=
HOMEASSISTANT_TOKEN=
# Comma-separated entity ids, e.g. sensor.dry_box_humidity,sensor.workshop_temperature
HOMEASSISTANT_ENTITIES=

# Telegram Bot (optional — leave empty to disable)
# Get a bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your chat ID (send /start to @userinfobot to find it)
TELEGRAM_CHAT_ID=

# Notification settings
# Progress update interval in percent (e.g. 25 = notify at 25%, 50%, 75%)
PROGRESS_INTERVAL=25

# ── Authentication (single user) ─────────────────────────────────────────────
# With none of these set the service answers EVERY request without credentials,
# including printer control and the camera. It logs a warning at startup saying so.
#
# Generate both values:   bun run auth:secret
#
# The password hash for the dashboard login. Quote it — it contains '$'.
AUTH_PASSWORD_HASH=
# Convenience alternative, hashed at startup. It is a plaintext credential in a file;
# prefer AUTH_PASSWORD_HASH.
AUTH_PASSWORD=
# Shared secret for machine clients that cannot hold a cookie: /mcp, Moonraker
# (Mainsail, Fluidd), OctoPrint (slicers). Sent as X-Api-Key or Authorization: Bearer.
# Separate from the password on purpose, so it can be rotated on its own.
AUTH_API_KEY=
# Session lifetime, and how long one survives unused. Hours.
AUTH_SESSION_HOURS=720
AUTH_IDLE_HOURS=168
# Set to false to keep auth off even with a password configured.
AUTH_ENABLED=
