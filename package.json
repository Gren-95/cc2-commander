{
  "name": "elegoo-web",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "simple-git-hooks": {
    "pre-commit": "bunx biome check --staged --write --no-errors-on-unmatched"
  },
  "scripts": {
    "dev": "concurrently -n svc,web -c magenta,cyan \"bun --watch src/server/index.ts\" \"vite\"",
    "dev:web": "vite",
    "dev:service": "bun --watch src/server/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "service": "bun src/server/index.ts",
    "service:check": "tsc --project tsconfig.server.json",
    "service:install": "sudo bash contrib/install.sh",
    "service:uninstall": "sudo bash contrib/uninstall.sh",
    "service:restart": "sudo systemctl restart elegooweb",
    "service:stop": "sudo systemctl stop elegooweb",
    "service:logs": "sudo journalctl -u elegooweb -f",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "docker:build": "docker build -t ghcr.io/runnane/elegoo-web:local .",
    "docker:verify": "docker run --rm -e PRINTER_IP=192.0.2.99 -e TELEGRAM_BOT_TOKEN= -e AI_ENABLED=false -e CAMERA_ENABLED=false ghcr.io/runnane/elegoo-web:local bun -e \"import('./src/server/config.js').then(()=>console.log('image OK'))\"",
    "gates": "bash scripts/gates.sh",
    "knip": "knip --no-config-hints",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "biome check --write",
    "prepare": "command -v git >/dev/null 2>&1 && git rev-parse --git-dir >/dev/null 2>&1 && simple-git-hooks >/dev/null 2>&1 || true",
    "auth:secret": "bun scripts/auth-secret.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@release-it/conventional-changelog": "^12.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "^1.4.2",
    "@types/jsdom": "^30.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/three": "0.178.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "release-it": "^21.0.2",
    "simple-git-hooks": "^2.11.1",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bootstrap-icons": "^1.13.1",
    "dotenv": "^17.4.2",
    "gcode-preview": "3.0.0-alpha.4",
    "grammy": "^1.45.1",
    "mqtt": "^5.15.2",
    "pdfkit": "^0.19.1",
    "sharp": "^0.35.3",
    "three": "0.178.0",
    "winston": "^3.19.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "undici": ">=6.24.0",
    "hono": ">=4.12.34",
    "@hono/node-server": ">=2.0.5",
    "qs": ">=6.15.2",
    "body-parser": ">=2.3.0",
    "fast-uri": ">=3.1.5",
    "ip-address": ">=10.3.1",
    "adm-zip": ">=0.6.0",
    "protobufjs": ">=7.6.5",
    "sharp": ">=0.35.0"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild",
    "onnxruntime-node",
    "protobufjs",
    "sharp",
    "simple-git-hooks"
  ],
  "knip": {
    "entry": [
      "index.html",
      "src/main.ts",
      "src/server/index.ts",
      "src/__tests__/**/*.test.ts",
      "src/__tests__/setup/*.ts"
    ],
    "project": [
      "src/**/*.ts",
      "*.config.ts"
    ],
    "include": [
      "files"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}",
      "tagName": "v${version}",
      "tagAnnotation": "Release v${version}",
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "tagArgs": [
        "--no-sign"
      ]
    },
    "github": {
      "release": true,
      "releaseName": "v${version}"
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "perf",
              "section": "Performance"
            },
            {
              "type": "refactor",
              "section": "Refactors"
            },
            {
              "type": "docs",
              "section": "Documentation"
            },
            {
              "type": "chore",
              "hidden": true
            },
            {
              "type": "style",
              "hidden": true
            },
            {
              "type": "test",
              "hidden": true
            }
          ]
        },
        "infile": "CHANGELOG.md",
        "header": "# Changelog"
      }
    },
    "hooks": {
      "before:init": "bun run lint && bun run format:check && bun run test",
      "after:bump": "bun run build && docker build -t ghcr.io/runnane/elegoo-web:${version} -t ghcr.io/runnane/elegoo-web:latest .",
      "after:release": "echo \"$GITHUB_TOKEN\" | docker login ghcr.io -u runnane --password-stdin && docker push ghcr.io/runnane/elegoo-web:${version} && docker push ghcr.io/runnane/elegoo-web:latest"
    }
  }
}
