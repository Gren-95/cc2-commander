{
  "name": "cc2-commander",
  "description": "Self-hosted web dashboard for the Elegoo Centauri Carbon 2 (CC2) \u2014 live status, camera, print control, file management, filament dryer, and Moonraker/OctoPrint compatibility.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gren-95/cc2-commander.git"
  },
  "homepage": "https://github.com/Gren-95/cc2-commander#readme",
  "license": "MIT",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "simple-git-hooks": {
    "pre-commit": "bunx biome check --staged --write --no-errors-on-unmatched"
  },
  "scripts": {
    "auth:secret": "bun scripts/auth-secret.ts",
    "build": "tsc && bun scripts/build.ts",
    "check": "biome check --write",
    "dev": "bun scripts/dev.ts",
    "dev:service": "bun --watch src/server/index.ts",
    "docker:build": "docker build -t ghcr.io/gren-95/cc2-commander:local .",
    "docker:verify": "docker run --rm -e PRINTER_IP=192.0.2.99 -e TELEGRAM_BOT_TOKEN= -e CAMERA_ENABLED=false ghcr.io/gren-95/cc2-commander:local bun -e \"import('./src/server/config.js').then(()=>console.log('image OK'))\"",
    "format": "biome format --write",
    "format:check": "biome format",
    "gates": "bash scripts/gates.sh",
    "knip": "knip --no-config-hints",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "prepare": "command -v git >/dev/null 2>&1 && git rev-parse --git-dir >/dev/null 2>&1 && simple-git-hooks >/dev/null 2>&1 || true",
    "service": "bun src/server/index.ts",
    "service:check": "tsc --project tsconfig.server.json",
    "test": "bun test src/__tests__ src/server/__tests__",
    "test:browser": "playwright test",
    "test:watch": "bun test --watch src/__tests__ src/server/__tests__",
    "screenshots": "bun scripts/screenshots.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/pdfkit": "^0.17.6",
    "@types/three": "0.178.1",
    "@types/ws": "^8.18.1",
    "knip": "^6.34.0",
    "simple-git-hooks": "^2.11.1",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "bootstrap-icons": "^1.13.1",
    "gcode-preview": "3.0.0-alpha.4",
    "grammy": "^1.45.1",
    "mqtt": "^5.15.2",
    "pdfkit": "^0.19.1",
    "sharp": "^0.35.4",
    "three": "0.178.0",
    "winston": "^3.19.0",
    "ws": "^8.21.3"
  },
  "overrides": {
    "undici": ">=6.24.0",
    "sharp": ">=0.35.4",
    "fflate": ">=0.8.3"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild",
    "sharp",
    "simple-git-hooks"
  ],
  "knip": {
    "entry": [
      "index.html",
      "src/main.ts",
      "src/server/index.ts",
      "src/__tests__/**/*.test.ts",
      "tests/browser/*.spec.ts",
      "scripts/test-harness.ts",
      "scripts/build.ts",
      "scripts/dev.ts",
      "scripts/auth-secret.ts",
      "playwright.config.ts"
    ],
    "project": [
      "src/**/*.ts",
      "scripts/*.ts",
      "tests/**/*.ts",
      "*.config.ts"
    ],
    "include": [
      "files"
    ]
  }
}
